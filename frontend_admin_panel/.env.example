# Supabase (required for real auth/data; leave unset to use mock/local mode)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_KEY=

# Admin panel base URL used for auth redirects (password reset / OAuth callback)
# Should be the deployed origin of this frontend (e.g. https://admin.example.com)
REACT_APP_FRONTEND_URL=
