# Admin Panel environment variables (Create React App)
# Copy to .env and fill values. Do NOT commit real secrets.

# Required for Supabase mode (auth + DB)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_KEY=

# Optional: backend URLs (used by other parts of the app, kept for parity)
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=

# Optional environment controls
REACT_APP_NODE_ENV=development
REACT_APP_LOG_LEVEL=info
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=true
REACT_APP_HEALTHCHECK_PATH=/healthz
REACT_APP_FEATURE_FLAGS={}
REACT_APP_EXPERIMENTS_ENABLED=false
REACT_APP_NEXT_TELEMETRY_DISABLED=1
