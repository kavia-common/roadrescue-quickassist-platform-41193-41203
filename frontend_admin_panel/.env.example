# Admin Panel environment variables (Create React App)
#
# Supabase (optional)
# If these are left empty, the admin panel can still run in demo mode (localStorage).
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_KEY=

# Demo Admin Mode
# Enable demo admin one-click login and bypass Supabase checks.
# Demo credentials (non-secret; demo only):
#   email: demo@roadrescue.local
#   password: demo123
REACT_APP_DEMO_ADMIN_ENABLED=true
